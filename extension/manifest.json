{
  "manifest_version": 3,
  "name": "Chrome Unbot Fingerprint",
  "version": "1.0",
  "description": "It gathers browser fingerprinting data and sends it to the Chrome Unbot backend.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Unbot"
  }
}
